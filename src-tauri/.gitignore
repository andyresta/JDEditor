# Generated by Cargo
# will have compiled files and executables
/target/

# Generated by Tauri
# will have schema files for capabilities auto-completion
/gen/schemas

# Bundled ffmpeg/ffprobe sidecars, fetched per-machine by
# `npm run fetch-ffmpeg` (see scripts/fetch-ffmpeg.mjs) — too large to
# commit, and they're platform/arch-specific anyway.
/binaries/*
!/binaries/.gitkeep
